# ---------------------------------------------------------------------------
# Secretos y credenciales — NUNCA versionar
# ---------------------------------------------------------------------------
# El archivo RepoTecnico/credenciales/CREDENCIALES-GGTO.md declara que está
# excluido por .gitignore, pero el .gitignore no existía: este archivo lo crea.
RepoTecnico/credenciales/
*credenciales*.md
*.jks
*.keystore
key.properties

# ---------------------------------------------------------------------------
# Datos de entrada con PII de suscriptores (H-01)
# ---------------------------------------------------------------------------
detalle_averias_gpon*.csv
RepoTecnico/entrada/
RepoTecnico/salida/
RepoTecnico/evidencias/

# ---------------------------------------------------------------------------
# Artefactos de construcción y binarios publicados
# ---------------------------------------------------------------------------
app_movil/build/
app_movil/.dart_tool/
app_movil/android/.gradle/
app_movil/android/local.properties
app_movil/.flutter-plugins
app_movil/.flutter-plugins-dependencies
app/web/dist/
app/web/node_modules/

# APK (se publican con scripts/publicar_apk.py; no se versionan)
app_movil/GGTOv2.apk
app_movil/app-release.apk
app/web/public/apk/ggto-tecnico.apk
app/web/public/apk/apk.json
app/web/public/apk/*.apk

# ---------------------------------------------------------------------------
# Cachés y temporales
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.zip

# Artefactos de las pruebas E2E
RepoTecnico/pruebas/e2e/test-results/
RepoTecnico/pruebas/logs/e2e-reporte/
RepoTecnico/pruebas/logs/*.log
