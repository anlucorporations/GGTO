<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): la pantalla de arranque la dibuja el sistema.
     Fondo de marca + símbolo CANTV; el color debe ser un color plano. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_simbolo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
