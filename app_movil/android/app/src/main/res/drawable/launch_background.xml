<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de arranque (antes: blanco liso). Degradado de marca con el
     símbolo CANTV centrado. En Android 12+ manda `values-v31/styles.xml`. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_degradado" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_simbolo" />
    </item>
</layer-list>
